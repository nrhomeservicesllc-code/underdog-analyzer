# Copy to .env and edit. Never commit .env.

# Strategy settings
MIN_ARB_EDGE=0.01          # only act on gaps of at least 1 cent per $1
TAKER_FEE=0.0              # raise this if the markets you trade charge taker fees
WHALE_MIN_USD=10000

# Risk limits (paper and live)
MAX_ORDER_USD=25
MAX_TOTAL_EXPOSURE_USD=200

# Live trading - leave at 0 until paper results convince you.
LIVE_TRADING=0
# Use a NEW wallet that holds only money you can afford to lose.
POLY_PRIVATE_KEY=
POLY_FUNDER=               # your Polymarket proxy wallet address (shown on polymarket.com)
POLY_SIGNATURE_TYPE=1      # 1 = email/Magic login, 2 = browser wallet, 0 = plain EOA
